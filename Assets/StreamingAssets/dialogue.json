[
 {
   "type": "Start",
   "id": "Start_Babyroom_00",
   "text": "어... 뭐지?"
 },
 {
   "type": "Start",
   "id": "Start_Babyroom_01",
   "text": "여긴 어릴 적 내 방 같은데?"
 },
 {
   "type": "Start",
   "id": "Start_Babyroom_02",
   "text": "전부 그 시절 그대로야"
 },
 {
   "type": "Start",
   "id": "Start_Babyroom_03",
   "text": "그래, 다시 시작 해보는 거야"
 },
 {
   "type": "Start",
   "id": "Start_Babyroom_04",
   "text": "이제는 조금 다르게 걷게 될지도 몰라"
 },
 {
   "type": "End",
   "id": "End_Babyroom_00",
   "text": "익숙한 이 길..."
 },
 {
   "type": "End",
   "id": "End_Babyroom_01",
   "text": "유치원 다닐 때의 길이잖아?"
 },
 {
   "type": "End",
   "id": "End_Babyroom_02",
   "text": "이 시절로 다시 올거라 상상도 못했는데"
 },
 {
   "type": "End",
   "id": "End_Babyroom_03",
   "text": "좋았어, 다시 한 번 해보자! 지금부터 시작이야"
 },
 {
   "type": "End",
   "id": "End_Babyroom_04",
   "text": "유치원 문 앞으로 가볼까?"
 },
 {
   "type": "End",
   "id": "End_Kindergarten_00",
   "text": "그저 놀이터였던 공간이"
 },
 {
   "type": "End",
   "id": "End_Kindergarten_01",
   "text": "이렇게 험난했었나..?"
 },
 {
   "type": "End",
   "id": "End_Kindergarten_02",
   "text": "괜찮아, 이번엔 넘어지더라도 포기하지말자"
 },
 {
   "type": "End",
   "id": "End_Kindergarten_03",
   "text": "예전에 나를 뛰어 넘어보자!"
 },
 {
   "type": "Start",
   "id": "Start_Looptop_00",
   "text": "여긴 초등학교?"
 },
 {
   "type": "Start",
   "id": "Start_Looptop_01",
   "text": "누군가는 여길 인생의 기초라고 부르지"
 },
 {
   "type": "Start",
   "id": "Start_EPath_00",
   "text": "그때, 막막했었던 그 시절"
 },
 {
   "type": "Start",
   "id": "Start_EPath_01",
   "text": "이제 나를 막을 건 없어"
 },
 {
   "type": "Start",
   "id": "Start_Elementary_00",
   "text": "이제야 저 의미를 알 것 같아"
 },
 {
   "type": "Start",
   "id": "Start_Elementary_01",
   "text": "잊지 않게, 기억 속에 잘 새겨놓자"
 },
 {
   "type": "Start",
   "id": "Start_Elementary_02",
   "text": "누구는 문제를 빨리 풀고"
 },
 {
   "type": "Start",
   "id": "Start_Elementary_03",
   "text": "누구는 처음부터 못 따라갔지"
 },
 {
   "type": "Start",
   "id": "Start_Elementary_04",
   "text": "이제는 괜찮아, 실패해도 두렵지 않아"
 },
 {
   "type": "Start",
   "id": "Start_Elementary_05",
   "text": "즐기며, 앞으로 계속해서 나아가 보자!"
 },
 {
   "type": "Guide",
   "id": "Guide_Elementary_00",
   "text": "트로피 받으려고 욕심 부리다가... 결국 다 망쳐버렸던 날이 생각이 나네"
 },
 {
   "type": "Guide",
   "id": "Guide_Elementary_01",
   "text": "오른쪽은 익숙한 길인데, 왼쪽은 낯설지만 뭔가 궁금하네"
 },
 {
   "type": "Guide",
   "id": "Guide_Elementary_02",
   "text": "컴퓨터실에서 몰래 플래시 게임하다가 걸려서 엄청 혼났었는데"
 },
 {
   "type": "Guide",
   "id": "Guide_Elementary_03",
   "text": "어렸을 때, 장남감 화산을 밟고 넘어졌던 기억이 나. 그 땐 꽤 많이 다쳤었지"
 },
 {
   "type": "Start",
   "id": "Start_MPath_00",
   "text": "공기가 바뀌었다."
 },
 {
   "type": "Start",
   "id": "Start_MPath_01",
   "text": "누가 정해준 것도 아닌데, 이 쯤부터 뭔가 달라졌지"
 },
 {
   "type": "Start",
   "id": "Start_Middle_00",
   "text": "주변은 자꾸 나에게서 정답을 원했고"
 },
 {
   "type": "Start",
   "id": "Start_Middle_01",
   "text": "나의 개성은 사라졌었지"
 },
 {
   "type": "Start",
   "id": "Start_Middle_02",
   "text": "이제는 내 꿈을 펼치며"
 },
 {
   "type": "Start",
   "id": "Start_Middle_03",
   "text": "도전하고 즐기며, 나의 개성을 찾아 볼거야"
 },
 {
   "type": "Start",
   "id": "Start_Middle_04",
   "text": "그렇다면 내가 조금만 자랐다는 뜻이겠지"
 },
 {
   "type": "Start",
   "id": "Start_Middle_05",
   "text": "방황하던 시절..."
 },
 {
   "type": "Start",
   "id": "Start_Middle_06",
   "text": "모든 게 막막하게만 보였고"
 },
 {
   "type": "Start",
   "id": "Start_Middle_07",
   "text": "세상이 나만 미워하는 것 같았지"
 },
 {
   "type": "Start",
   "id": "Start_Middle_08",
   "text": "불만은 많고, 마음은 복잡해서..."
 },
 {
   "type": "Start",
   "id": "Start_Middle_09",
   "text": "괜히 거리만 서성였던 날들이었어"
 },
 {
   "type": "Start",
   "id": "Start_Middle_10",
   "text": "그런데 지금 생각해보면"
 },
 {
   "type": "Start",
   "id": "Start_Middle_11",
   "text": "그 시간들도 결국 나를 자라게 했더라"
 },
 {
   "type": "Start",
   "id": "Start_Middle_12",
   "text": "아직도 부족한 건 많지만..."
 },
 {
   "type": "Start",
   "id": "Start_Middle_13",
   "text": "예전의 나보단"
 },
 {
   "type": "Start",
   "id": "Start_Middle_14",
   "text": "분명 조금은 더 단단해졌어"
 },
 {
   "type": "End",
   "id": "End_Middle_00",
   "text": "어릴 땐 방황도 필요했어.."
 },
 {
   "type": "End",
   "id": "End_Middle_01",
   "text": "그 시간을 지나고 나서야"
 },
 {
   "type": "End",
   "id": "End_Middle_02",
   "text": "뭐가 중요한지 조금은 보이니까"
 },
 {
   "type": "Start",
   "id": "Start_HPath_00",
   "text": "오른쪽은 기술을 익히는 길"
 },
 {
   "type": "Start",
   "id": "Start_HPath_01",
   "text": "왼쪽은 공부에 집중하는 길"
 },
 {
   "type": "Start",
   "id": "Start_HPath_02",
   "text": "그땐 뭘 더 잘 할 수 있었을까"
 },
 {
   "type": "Start",
   "id": "Start_HighStudy_00",
   "text": "익숙한 이 정적..."
 },
 {
   "type": "Start",
   "id": "Start_HighStudy_01",
   "text": "이 자리에서 시간을 흘려보냈었지"
 },
 {
   "type": "Start",
   "id": "Start_HighStudy_02",
   "text": "책을 넘기는 소리"
 },
 {
   "type": "Start",
   "id": "Start_HighStudy_03",
   "text": "조용히 흔들리는 형광등"
 },
 {
   "type": "Start",
   "id": "Start_HighStudy_04",
   "text": "그땐 단지 시험을 위해 앉았었지..."
 },
 {
   "type": "Start",
   "id": "Start_HighStudy_05",
   "text": "의미 없다고 생각했던 그 날들이."
 },
 {
   "type": "Start",
   "id": "Start_HighStudy_06",
   "text": "나도 모르게 쌓여 있었더라"
 },
 {
   "type": "Start",
   "id": "Start_HighStudy_07",
   "text": "여기서 흘려보낸 시간도"
 },
 {
   "type": "Start",
   "id": "Start_HighStudy_08",
   "text": "결국 날 이 자리로 데려온 거니까"
 },
 {
   "type": "Start",
   "id": "Start_HighArtMusic_00",
   "text": "여긴 매일 손 끝과 숨소리에 온 신경을 쏟았던 곳이네"
 },
 {
   "type": "Start",
   "id": "Start_HighArtMusic_01",
   "text": "한 줄, 한 음.. 그걸 잡으려고 하루가 다 지나가곤했지"
 },
 {
   "type": "Start",
   "id": "Start_HighArtMusic_02",
   "text": "몰랐지만 그 시간들이 나를 조금씩 만들고 있었던 거야.."
 },
 {
   "type": "Start",
   "id": "Start_HighArtMusic_03",
   "text": "이제는 누가 시키지 않아도"
 },
 {
   "type": "Start",
   "id": "Start_HighArtMusic_04",
   "text": "난 이 길 위에 서게 될 거야"
 },
 {
   "type": "Start",
   "id": "Start_HighExam_00",
   "text": "결국, 이 길을 또 오게 되었네"
 },
 {
   "type": "Start",
   "id": "Start_HighExam_01",
   "text": "누군가는 책으로, 누군가는 손 끝으로"
 },
 {
   "type": "Start",
   "id": "Start_HighExam_02",
   "text": "각자의 시간을 쌓아 왔고"
 },
 {
   "type": "Start",
   "id": "Start_HighExam_03",
   "text": "종착지는 같았어"
 },
 {
   "type": "Start",
   "id": "Start_HighExam_04",
   "text": "공부는 피해갈 수 없더라"
 },
 {
   "type": "Start",
   "id": "Start_HighExam_05",
   "text": "학생 시절의 마지막 종착지.."
 },
 {
   "type": "Start",
   "id": "Start_HighExam_06",
   "text": "지금이라도 늦지 않았으니 다시 시작해보자 "
 },
  {
    "type": "End",
    "id": "End_HighSchool_00",
    "text": "시간이 다시 흐름을 거슬러도, 모든 게 마법처럼 달라지진 않아\n 같은 길에서 같은 돌부리에 걸려 넘어질 수도, 똑같은 벽 앞에서 멈춰 설 수도 있지"
  },
  {
    "type": "End",
    "id": "End_HighSchool_01",
    "text": "하지만 그건 실패가 아니라, 더 단단해질 기회야\n 넘어지고, 다시 일어서고, 또다시 도전하는 그 과정이… 나를 앞으로 나아가게 만들지\n 그리고 무엇보다, 스스로 다시 돌아갈 기회를 만들 수 있다는 걸 잊지 말아야 해"
  }
]